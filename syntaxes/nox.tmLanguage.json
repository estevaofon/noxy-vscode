{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nox",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#function-declaration" },
    { "include": "#function-call" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nox",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nox",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nox",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.nox",
          "match": "\\b-?\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.nox",
          "match": "\\b-?\\d+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.nox",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nox",
          "match": "\\b(if|then|else|while|do|for|in|return|end)\\b"
        },
        {
          "name": "keyword.other.nox",
          "match": "\\b(struct|func|let|ref)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.nox",
          "match": "\\b(int|string|bool|void)\\b"
        }
      ]
    },
    "function-declaration": {
      "patterns": [
        {
          "match": "\\b(struct)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.nox" },
            "2": { "name": "entity.name.type.struct.nox" }
          }
        },
        {
          "match": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "keyword.other.nox" },
            "2": { "name": "entity.name.function.declaration.nox" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "name": "support.function.builtin.nox",
          "match": "\\b(print|strlen|ord|to_str|str_eq)\\s*(?=\\()"
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.nox" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.nox",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.range.nox",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arrow.nox",
          "match": "->"
        },
        {
          "name": "keyword.operator.assignment.nox",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.nox",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.nox",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.nox",
          "match": ":"
        },
        {
          "name": "punctuation.definition.block.nox",
          "match": "[{}()]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*:",
          "captures": {
            "1": { "name": "variable.parameter.nox" }
          }
        },
        {
          "match": "\\b(let)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.nox" },
            "2": { "name": "variable.other.declaration.nox" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "name": "variable.other.nox"
        }
      ]
    }
  },
  "scopeName": "source.nox"
}