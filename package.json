{
  "name": "noxy-language",
  "displayName": "Noxy Language Support",
  "description": "Syntax highlighting and language support for the Noxy programming language",
  "version": "1.0.0",
  "publisher": "estev",
  "engines": {
    "vscode": "^1.74.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/estevaofon/noxy-vscode.git"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "noxy",
    "syntax",
    "highlighting",
    "language"
  ],

  "contributes": {
    "languages": [
      {
        "id": "noxy",
        "aliases": [
          "Noxy",
          "noxy"
        ],
        "extensions": [
          ".nx",
          ".nox",
          ".noxy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "noxy",
        "scopeName": "source.noxy",
        "path": "./syntaxes/noxy.tmLanguage.json"
      }
    ]
  },
  "license": "MIT"
}